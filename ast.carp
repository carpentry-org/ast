(doc AST "Structural annotations for Carp source forms.

`ann` walks a quoted source form and produces a dynamic map describing
it — one variant per Carp special form, plus one per literal kind.
`unann` reverses the process, reconstructing the source from a
(possibly rewritten) annotation map. The pair lets you inspect, analyze,
and rewrite Carp code as data without tripping over the irregular shapes
of def/defn/let/match/register/etc.")
(defmodule AST
  (hidden ann-def)
  (defndynamic ann-def [static? l]
    {'value l
     'type 'def
     'name (cadr l)
     'bound-to (AST.ann (caddr l))
     'static? static?})

  (hidden ann-defn)
  (defndynamic ann-defn [static? l]
    {'value l
     'type 'defn
     'name (cadr l)
     'arguments (caddr l)
     'body (AST.ann (cadddr l))
     'static? static?})

  (hidden ann-do)
  (defndynamic ann-do [l]
    (let [body (map AST.ann (cdr l))]
      {'value l
       'type 'do
       'body body
       'returns (last body)}))

  (hidden ann-while)
  (defndynamic ann-while [l]
    {'value l
     'type 'while
     'condition (AST.ann (cadr l))
     'body (AST.ann (caddr l))})

  (hidden ann-if)
  (defndynamic ann-if [l]
    {'value l
     'type 'if
     'condition (AST.ann (cadr l))
     'then (AST.ann (caddr l))
     'else (AST.ann (cadddr l))})

  (hidden ann-quote)
  (defndynamic ann-quote [l] {'value l
                              'type 'quote
                              'body (AST.ann (cadr l))})

  (hidden ann-deftype)
  (defndynamic ann-deftype [l]
    {'value l
     'type 'deftype
     'name (cadr l)
     'body (caddr l)})

  (hidden ann-register)
  (defndynamic ann-register [l]
    (let [name (cadr l)
          signature (caddr l)
          external-name (if (= (length l) 4) (cadddr l) nil)]
      {'value l
       'type 'register
       'name name
       'signature signature
       'external-name external-name}))

  (hidden ann-register-type)
  (defndynamic ann-register-type [l]
    (let [name (cadr l)
          len (length l)]
      (cond
        (= len 2)
          {'value l
           'type 'register-type
           'name name
           'body 'unknown
           'external-name nil}
        (= len 3)
          (if (string? (caddr l))
            {'value l
             'type 'register-type
             'name name
             'body 'unknown
             'external-name (caddr l)}
            {'value l
             'type 'register-type
             'name name
             'body (caddr l)
             'external-name nil})
        (= len 4)
          {'value l
           'type 'register-type
           'name name
           'body (cadddr l)
           'external-name (caddr l)}
        (macro-error (list "ann-register-type: invalid form " l)))))

  (hidden ann-defmodule)
  (defndynamic ann-defmodule [l]
    {'value l
     'type 'defmodule
     'name (cadr l)
     'body (map AST.ann (cddr l))})

  (hidden ann-let-bindings)
  (defndynamic ann-let-bindings [bindings]
    (if (empty? bindings)
      '()
      (cons
        {'type 'let-binding
         'name (car bindings)
         'binding (AST.ann (cadr bindings))}
        (AST.ann-let-bindings (cddr bindings)))))

  (hidden ann-let)
  (defndynamic ann-let [l]
    {'value l
     'type 'let
     'bindings (AST.ann-let-bindings (cadr l))
     'body (AST.ann (caddr l))})

  (hidden ann-fn)
  (defndynamic ann-fn [l]
    {'value l
     'type 'fn
     'arguments (cadr l)
     'body (AST.ann (caddr l))})

  (hidden ann-break)
  (defndynamic ann-break [l] {'value l
                              'type 'break})

  (hidden ann-set)
  (defndynamic ann-set [l]
    {'value l
     'type 'set!
     'target (AST.ann (cadr l))
     'bound-to (AST.ann (caddr l))})

  (hidden ann-the)
  (defndynamic ann-the [l]
    {'value l
     'type 'the
     'target-type (cadr l)
     'body (AST.ann (caddr l))})

  (hidden ann-ref)
  (defndynamic ann-ref [l] {'value l
                            'type 'ref
                            'body (AST.ann (cadr l))})

  (hidden ann-deref)
  (defndynamic ann-deref [l] {'value l
                              'type 'deref
                              'body (AST.ann (cadr l))})

  (hidden ann-with)
  (defndynamic ann-with [l]
    {'value l
     'type 'with
     'module (cadr l)
     'body (map AST.ann (cddr l))})

  (hidden ann-match-cases)
  (defndynamic ann-match-cases [cases]
    (if (empty? cases)
      '()
      (cons
        {'pattern (car cases)
         'body (AST.ann (cadr cases))}
        (AST.ann-match-cases (cddr cases)))))

  (hidden ann-match)
  (defndynamic ann-match [l]
    {'value l
     'type 'match
     'scrutinee (AST.ann (cadr l))
     'cases (AST.ann-match-cases (cddr l))})

  (hidden ann-match-ref)
  (defndynamic ann-match-ref [l]
    {'value l
     'type 'match-ref
     'scrutinee (AST.ann (cadr l))
     'cases (AST.ann-match-cases (cddr l))})

  (hidden ann-cond-pairs)
  (defndynamic ann-cond-pairs [args]
    (if (< (length args) 2)
      '()
      (cons
        {'condition (AST.ann (car args))
         'body (AST.ann (cadr args))}
        (AST.ann-cond-pairs (cddr args)))))

  (hidden ann-cond-else)
  (defndynamic ann-cond-else [args]
    (cond
      (empty? args) nil
      (empty? (cdr args)) (AST.ann (car args))
      (AST.ann-cond-else (cddr args))))

  (hidden ann-cond)
  (defndynamic ann-cond [l]
    (let [args (cdr l)]
      {'value l
       'type 'cond
       'cases (AST.ann-cond-pairs args)
       'else (AST.ann-cond-else args)}))

  (hidden ann-case-pairs)
  (defndynamic ann-case-pairs [args]
    (if (< (length args) 2)
      '()
      (cons
        {'pattern (car args)
         'body (AST.ann (cadr args))}
        (AST.ann-case-pairs (cddr args)))))

  (hidden ann-case)
  (defndynamic ann-case [l]
    (let [args (cddr l)]
      {'value l
       'type 'case
       'scrutinee (AST.ann (cadr l))
       'cases (AST.ann-case-pairs args)
       'else (AST.ann-cond-else args)}))

  (hidden ann-for)
  (defndynamic ann-for [l]
    (let [binding (cadr l)]
      {'value l
       'type 'for
       'variable (car binding)
       'from (AST.ann (cadr binding))
       'to (AST.ann (caddr binding))
       'body (AST.ann (caddr l))}))

  (hidden ann-address)
  (defndynamic ann-address [l]
    {'value l
     'type 'address
     'body (AST.ann (cadr l))})

  (hidden ann-defmacro)
  (defndynamic ann-defmacro [l]
    {'value l
     'type 'defmacro
     'name (cadr l)
     'arguments (caddr l)
     'body (AST.ann (cadddr l))})

  (hidden ann-definterface)
  (defndynamic ann-definterface [l]
    {'value l
     'type 'definterface
     'name (cadr l)
     'signature (caddr l)})

  (hidden ann-use)
  (defndynamic ann-use [l] {'value l
                            'type 'use
                            'module (cadr l)})

  (hidden ann-load)
  (defndynamic ann-load [l] {'value l
                             'type 'load
                             'path (cadr l)})

  (hidden ann-doc)
  (defndynamic ann-doc [l]
    {'value l
     'type 'doc
     'name (cadr l)
     'docstring (caddr l)})

  (hidden ann-hidden)
  (defndynamic ann-hidden [l] {'value l
                               'type 'hidden
                               'name (cadr l)})

  (hidden ann-private)
  (defndynamic ann-private [l] {'value l
                                'type 'private
                                'name (cadr l)})

  (hidden ann-implements)
  (defndynamic ann-implements [l]
    {'value l
     'type 'implements
     'interface (cadr l)
     'function (caddr l)})

  (hidden BUILTINS)
  (defdynamic BUILTINS
    {'defdynamic (curry AST.ann-def false)
     'defndynamic (curry AST.ann-defn false)
     'def (curry AST.ann-def true)
     'defn (curry AST.ann-defn true)
     'do AST.ann-do
     'while AST.ann-while
     'if AST.ann-if
     'quote AST.ann-quote
     'deftype AST.ann-deftype
     'register AST.ann-register
     'register-type AST.ann-register-type
     'defmodule AST.ann-defmodule
     'let AST.ann-let
     'fn AST.ann-fn
     'break AST.ann-break
     'set! AST.ann-set
     'the AST.ann-the
     'ref AST.ann-ref
     'deref AST.ann-deref
     'with AST.ann-with
     'match AST.ann-match
     'match-ref AST.ann-match-ref
     'cond AST.ann-cond
     'case AST.ann-case
     'for AST.ann-for
     'address AST.ann-address
     'defmacro AST.ann-defmacro
     'definterface AST.ann-definterface
     'use AST.ann-use
     'load AST.ann-load
     'doc AST.ann-doc
     'hidden AST.ann-hidden
     'private AST.ann-private
     'implements AST.ann-implements})

  (hidden ann-list)
  (defndynamic ann-list [l]
    (cond
      (empty? l) {'value l
                  'type 'unit}
      (Map.contains? AST.BUILTINS (car l))
        (let [f (Map.get AST.BUILTINS (car l))] (f l))
      {'value l
       'type 'application
       'function (AST.ann (car l))
       'arguments (map AST.ann (cdr l))}))

  (doc ann "annotates a Carp source form with structural metadata.

Takes a quoted form `l` and returns a dynamic map. Every annotation has
two common keys: `'value` holds the original form, and `'type` is a
variant tag. Additional keys depend on the tag.

Literals:
- `'symbol`, `'string`, `'boolean`, `'character`: just `'value`.
- `'number`: `'value` and `'width` (one of `'int` `'long` `'float`
  `'double` `'byte`).
- `'unit`: the empty list `()`.
- `'array`: `'value` is an array of recursively annotated elements.

Special forms:
- `'application`: `'function`, `'arguments`.
- `'def`: `'name`, `'bound-to`, `'static?` (false for `defdynamic`).
- `'defn`: `'name`, `'arguments` (raw), `'body`, `'static?`
  (false for `defndynamic`).
- `'do`: `'body` (list), `'returns` (last element).
- `'while`: `'condition`, `'body`.
- `'if`: `'condition`, `'then`, `'else`.
- `'quote`, `'ref`, `'deref`: `'body`.
- `'deftype`: `'name`, `'body` (raw members).
- `'register`: `'name`, `'signature` (raw), `'external-name` (string
  or `nil`).
- `'register-type`: `'name`, `'body` (raw members or `'unknown`),
  `'external-name` (string or `nil`).
- `'defmodule`: `'name`, `'body` (list).
- `'let`: `'bindings` (list of `{'type 'let-binding 'name 'binding}`),
  `'body`.
- `'fn`: `'arguments` (raw), `'body`.
- `'break`: no extra fields.
- `'set!`: `'target`, `'bound-to`.
- `'the`: `'target-type` (raw), `'body`.
- `'with`: `'module` (raw), `'body` (list).
- `'match` / `'match-ref`: `'scrutinee`, `'cases` (list of
  `{'pattern 'body}`; patterns are raw).
- `'cond`: `'cases` (list of `{'condition 'body}`), `'else` (or `nil`).
- `'case`: `'scrutinee`, `'cases` (list of `{'pattern 'body}`; patterns
  are raw), `'else` (or `nil`).
- `'for`: `'variable` (raw), `'from`, `'to`, `'body`.
- `'address`: `'body`.
- `'defmacro`: `'name`, `'arguments` (raw), `'body`.
- `'definterface`: `'name`, `'signature` (raw).
- `'use`: `'module` (raw).
- `'load`: `'path` (raw).
- `'doc`: `'name`, `'docstring`.
- `'hidden` / `'private`: `'name`.
- `'implements`: `'interface`, `'function`.

Unknown forms produce a `macro-error`.")
  (defndynamic ann [l]
    (cond
      (list? l) (AST.ann-list l)
      (array? l) {'value (collect-into (map AST.ann l) array)
                  'type 'array}
      (number? l) {'value l
                   'type 'number
                   'width (dynamic-type l)}
      (string? l) {'value l
                   'type 'string}
      (symbol? l) {'value l
                   'type 'symbol}
      (= (dynamic-type l) 'bool) {'value l
                                  'type 'boolean}
      (= (dynamic-type l) 'char) {'value l
                                  'type 'character}
      (macro-error
        (list "ann got an unexpected value: " l " of type " (dynamic-type l)))))

  (hidden unann-register)
  (defndynamic unann-register [m]
    (let [extname (Map.get m 'external-name)]
      (if (= nil extname)
        (list 'register (Map.get m 'name) (Map.get m 'signature))
        (list 'register (Map.get m 'name) (Map.get m 'signature) extname))))

  (hidden unann-register-type)
  (defndynamic unann-register-type [m]
    (let [name (Map.get m 'name)
          body (Map.get m 'body)
          extname (Map.get m 'external-name)
          has-body (/= body 'unknown)
          has-ext (/= nil extname)]
      (cond
        (and has-ext has-body) (list 'register-type name extname body)
        has-body (list 'register-type name body)
        has-ext (list 'register-type name extname)
        (list 'register-type name))))

  (hidden unann-let-bindings-list)
  (defndynamic unann-let-bindings-list [bindings]
    (if (empty? bindings)
      '()
      (let [b (car bindings)]
        (cons (Map.get b 'name)
              (cons (AST.unann (Map.get b 'binding))
                    (AST.unann-let-bindings-list (cdr bindings)))))))

  (hidden unann-let-bindings)
  (defndynamic unann-let-bindings [bindings]
    (collect-into (AST.unann-let-bindings-list bindings) array))

  (hidden unann-match-cases)
  (defndynamic unann-match-cases [cases]
    (if (empty? cases)
      '()
      (let [case-map (car cases)]
        (cons (Map.get case-map 'pattern)
              (cons (AST.unann (Map.get case-map 'body))
                    (AST.unann-match-cases (cdr cases)))))))

  (hidden unann-cond-cases)
  (defndynamic unann-cond-cases [cases else-ann]
    (if (empty? cases)
      (if (= nil else-ann) '() (list else-ann))
      (let [case-map (car cases)]
        (cons
          (AST.unann (Map.get case-map 'condition))
          (cons (AST.unann (Map.get case-map 'body))
                (AST.unann-cond-cases (cdr cases) else-ann))))))

  (hidden unann-case-cases)
  (defndynamic unann-case-cases [cases else-ann]
    (if (empty? cases)
      (if (= nil else-ann) '() (list else-ann))
      (let [case-map (car cases)]
        (cons (Map.get case-map 'pattern)
              (cons (AST.unann (Map.get case-map 'body))
                    (AST.unann-case-cases (cdr cases) else-ann))))))

  (doc unann "reconstructs a Carp source form from an annotation map
produced by `ann`.

The round-trip property holds: `(unann (ann x))` equals `x` for every
supported form. Because the reconstruction reads the variant-specific
child keys rather than the original `'value` slot, you can modify an
annotation and `unann` will emit the rewritten form. Unknown type tags
produce a `macro-error`.")
  (defndynamic unann [m]
    (let [tag (Map.get m 'type)]
      (cond
        (List.in? tag '(symbol string boolean character number))
          (Map.get m 'value)
        (= tag 'unit) '()
        (= tag 'array) (collect-into (map AST.unann (Map.get m 'value)) array)
        (= tag 'application)
          (cons (AST.unann (Map.get m 'function))
                (map AST.unann (Map.get m 'arguments)))
        (= tag 'def)
          (list
            (if (Map.get m 'static?) 'def 'defdynamic)
            (Map.get m 'name)
            (AST.unann (Map.get m 'bound-to)))
        (= tag 'defn)
          (list
            (if (Map.get m 'static?) 'defn 'defndynamic)
            (Map.get m 'name)
            (Map.get m 'arguments)
            (AST.unann (Map.get m 'body)))
        (= tag 'do) (cons 'do (map AST.unann (Map.get m 'body)))
        (= tag 'while)
          (list 'while
                (AST.unann (Map.get m 'condition))
                (AST.unann (Map.get m 'body)))
        (= tag 'if)
          (list 'if
                (AST.unann (Map.get m 'condition))
                (AST.unann (Map.get m 'then))
                (AST.unann (Map.get m 'else)))
        (List.in? tag '(quote ref deref address))
          (list tag (AST.unann (Map.get m 'body)))
        (= tag 'deftype) (list 'deftype (Map.get m 'name) (Map.get m 'body))
        (= tag 'register) (AST.unann-register m)
        (= tag 'register-type) (AST.unann-register-type m)
        (= tag 'defmodule)
          (cons 'defmodule
                (cons (Map.get m 'name) (map AST.unann (Map.get m 'body))))
        (= tag 'let)
          (list 'let
                (AST.unann-let-bindings (Map.get m 'bindings))
                (AST.unann (Map.get m 'body)))
        (= tag 'fn)
          (list 'fn (Map.get m 'arguments) (AST.unann (Map.get m 'body)))
        (= tag 'break) '(break)
        (= tag 'set!)
          (list 'set!
                (AST.unann (Map.get m 'target))
                (AST.unann (Map.get m 'bound-to)))
        (= tag 'the)
          (list 'the (Map.get m 'target-type) (AST.unann (Map.get m 'body)))
        (= tag 'with)
          (cons 'with
                (cons (Map.get m 'module) (map AST.unann (Map.get m 'body))))
        (= tag 'match)
          (cons 'match
                (cons (AST.unann (Map.get m 'scrutinee))
                      (AST.unann-match-cases (Map.get m 'cases))))
        (= tag 'match-ref)
          (cons 'match-ref
                (cons (AST.unann (Map.get m 'scrutinee))
                      (AST.unann-match-cases (Map.get m 'cases))))
        (= tag 'cond)
          (let [else-val (Map.get m 'else)]
            (cons 'cond
                  (AST.unann-cond-cases (Map.get m 'cases)
                                        (if (= nil else-val)
                                          nil
                                          (AST.unann else-val)))))
        (= tag 'case)
          (let [else-val (Map.get m 'else)]
            (cons 'case
                  (cons (AST.unann (Map.get m 'scrutinee))
                        (AST.unann-case-cases (Map.get m 'cases)
                                              (if (= nil else-val)
                                                nil
                                                (AST.unann else-val))))))
        (= tag 'for)
          (list 'for
                (collect-into
                  (list (Map.get m 'variable)
                        (AST.unann (Map.get m 'from))
                        (AST.unann (Map.get m 'to)))
                  array)
                (AST.unann (Map.get m 'body)))
        (= tag 'defmacro)
          (list 'defmacro
                (Map.get m 'name)
                (Map.get m 'arguments)
                (AST.unann (Map.get m 'body)))
        (= tag 'definterface)
          (list 'definterface (Map.get m 'name) (Map.get m 'signature))
        (= tag 'use) (list 'use (Map.get m 'module))
        (= tag 'load) (list 'load (Map.get m 'path))
        (= tag 'doc) (list 'doc (Map.get m 'name) (Map.get m 'docstring))
        (List.in? tag '(hidden private)) (list tag (Map.get m 'name))
        (= tag 'implements)
          (list 'implements (Map.get m 'interface) (Map.get m 'function))
        (macro-error (list "unann: unknown type tag " tag))))))
