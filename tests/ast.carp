(load "ast.carp")
(load "Test.carp")
(use Test)

(deftest test
  (assert-dynamic-op test
                     {'value 'foo
                      'type 'symbol}
                     (AST.ann 'foo)
                     "annotates symbol"
                     Dynamic.Map.=)

  (assert-dynamic-op test
                     {'value 1
                      'type 'number
                      'width 'int}
                     (AST.ann '1)
                     "annotates int literal"
                     Dynamic.Map.=)

  (assert-dynamic-op test
                     {'value 1f
                      'type 'number
                      'width 'float}
                     (AST.ann '1f)
                     "annotates float literal"
                     Dynamic.Map.=)

  (assert-dynamic-op test
                     {'value 1.0
                      'type 'number
                      'width 'double}
                     (AST.ann '1.0)
                     "annotates double literal"
                     Dynamic.Map.=)

  (assert-dynamic-op test
                     {'value "hi"
                      'type 'string}
                     (AST.ann '"hi")
                     "annotates string literal"
                     Dynamic.Map.=)

  (assert-dynamic-op test
                     {'value true
                      'type 'boolean}
                     (AST.ann 'true)
                     "annotates boolean literal"
                     Dynamic.Map.=)

  (assert-dynamic-op test
                     {'value \a
                      'type 'character}
                     (AST.ann '\a)
                     "annotates character literal"
                     Dynamic.Map.=)

  (assert-dynamic-op test
                     {'value '()
                      'type 'unit}
                     (AST.ann '())
                     "annotates empty list as unit"
                     Dynamic.Map.=)

  (assert-dynamic-op test
                     {'value [{'value 1
                               'type 'number
                               'width 'int}
                              {'value 2
                               'type 'number
                               'width 'int}]
                      'type 'array}
                     (AST.ann '[1 2])
                     "annotates array literal"
                     Dynamic.Map.=)

  (assert-dynamic-op test
                     {'value '(a 1 2f)
                      'type 'application
                      'function {'value 'a
                                 'type 'symbol}
                      'arguments (list {'value 1
                                        'type 'number
                                        'width 'int}
                                       {'value 2
                                        'type 'number
                                        'width 'float})}
                     (AST.ann '(a 1 2f))
                     "annotates function application"
                     Dynamic.Map.=)

  (assert-dynamic-op test
                     {'value '(def a 1)
                      'type 'def
                      'name 'a
                      'bound-to {'value 1
                                 'type 'number
                                 'width 'int}
                      'static? true}
                     (AST.ann '(def a 1))
                     "annotates def as static"
                     Dynamic.Map.=)

  (assert-dynamic-op test
                     {'value '(defdynamic a 1)
                      'type 'def
                      'name 'a
                      'bound-to {'value 1
                                 'type 'number
                                 'width 'int}
                      'static? false}
                     (AST.ann '(defdynamic a 1))
                     "annotates defdynamic as non-static"
                     Dynamic.Map.=)

  (assert-dynamic-op test
                     {'value '(defn f [a] a)
                      'type 'defn
                      'name 'f
                      'arguments '[a]
                      'body {'value 'a
                             'type 'symbol}
                      'static? true}
                     (AST.ann '(defn f [a] a))
                     "annotates defn as static"
                     Dynamic.Map.=)

  (assert-dynamic-op test
                     {'value '(defndynamic f [a] a)
                      'type 'defn
                      'name 'f
                      'arguments '[a]
                      'body {'value 'a
                             'type 'symbol}
                      'static? false}
                     (AST.ann '(defndynamic f [a] a))
                     "annotates defndynamic as non-static"
                     Dynamic.Map.=)

  (assert-dynamic-op test
                     {'value '(do 1 2)
                      'type 'do
                      'body (list {'value 1
                                   'type 'number
                                   'width 'int}
                                  {'value 2
                                   'type 'number
                                   'width 'int})
                      'returns {'value 2
                                'type 'number
                                'width 'int}}
                     (AST.ann '(do 1 2))
                     "annotates do with last expression as returns"
                     Dynamic.Map.=)

  (assert-dynamic-op test
                     {'value '(while true 1)
                      'type 'while
                      'condition {'value true
                                  'type 'boolean}
                      'body {'value 1
                             'type 'number
                             'width 'int}}
                     (AST.ann '(while true 1))
                     "annotates while"
                     Dynamic.Map.=)

  (assert-dynamic-op test
                     {'value '(if true 1 2)
                      'type 'if
                      'condition {'value true
                                  'type 'boolean}
                      'then {'value 1
                             'type 'number
                             'width 'int}
                      'else {'value 2
                             'type 'number
                             'width 'int}}
                     (AST.ann '(if true 1 2))
                     "annotates if with three arms"
                     Dynamic.Map.=)

  (assert-dynamic-op test
                     {'value '(quote foo)
                      'type 'quote
                      'body {'value 'foo
                             'type 'symbol}}
                     (AST.ann '(quote foo))
                     "annotates quote"
                     Dynamic.Map.=)

  (assert-dynamic-op test
                     {'value '(deftype Foo [x Int])
                      'type 'deftype
                      'name 'Foo
                      'body '[x Int]}
                     (AST.ann '(deftype Foo [x Int]))
                     "annotates deftype"
                     Dynamic.Map.=)

  (assert-dynamic-op test
                     {'value '(register foo (Fn [] Int))
                      'type 'register
                      'name 'foo
                      'signature '(Fn [] Int)
                      'external-name nil}
                     (AST.ann '(register foo (Fn [] Int)))
                     "annotates register without override"
                     Dynamic.Map.=)

  (assert-dynamic-op test
                     {'value '(register foo (Fn [] Int) "foo_c")
                      'type 'register
                      'name 'foo
                      'signature '(Fn [] Int)
                      'external-name "foo_c"}
                     (AST.ann '(register foo (Fn [] Int) "foo_c"))
                     "annotates register with override"
                     Dynamic.Map.=)

  (assert-dynamic-op test
                     {'value '(register-type Foo)
                      'type 'register-type
                      'name 'Foo
                      'body 'unknown
                      'external-name nil}
                     (AST.ann '(register-type Foo))
                     "annotates bare register-type"
                     Dynamic.Map.=)

  (assert-dynamic-op test
                     {'value '(register-type Foo [x Int])
                      'type 'register-type
                      'name 'Foo
                      'body '[x Int]
                      'external-name nil}
                     (AST.ann '(register-type Foo [x Int]))
                     "annotates register-type with members"
                     Dynamic.Map.=)

  (assert-dynamic-op test
                     {'value '(register-type Foo "Foo_c")
                      'type 'register-type
                      'name 'Foo
                      'body 'unknown
                      'external-name "Foo_c"}
                     (AST.ann '(register-type Foo "Foo_c"))
                     "annotates register-type with only override"
                     Dynamic.Map.=)

  (assert-dynamic-op test
                     {'value '(register-type Foo "Foo_c" [x Int])
                      'type 'register-type
                      'name 'Foo
                      'body '[x Int]
                      'external-name "Foo_c"}
                     (AST.ann '(register-type Foo "Foo_c" [x Int]))
                     "annotates register-type with override and members"
                     Dynamic.Map.=)

  (assert-dynamic-op test
                     {'value '(defmodule Foo (def x 1))
                      'type 'defmodule
                      'name 'Foo
                      'body (list
                        {'value '(def x 1)
                         'type 'def
                         'name 'x
                         'bound-to {'value 1
                                    'type 'number
                                    'width 'int}
                         'static? true})}
                     (AST.ann '(defmodule Foo (def x 1)))
                     "annotates defmodule"
                     Dynamic.Map.=)

  (assert-dynamic-op test
                     {'value '(let [a 1] b)
                      'type 'let
                      'bindings (list
                        {'type 'let-binding
                         'name 'a
                         'binding {'value 1
                                   'type 'number
                                   'width 'int}})
                      'body {'value 'b
                             'type 'symbol}}
                     (AST.ann '(let [a 1] b))
                     "annotates let"
                     Dynamic.Map.=)

  (assert-dynamic-op test
                     {'value '(fn [a] a)
                      'type 'fn
                      'arguments '[a]
                      'body {'value 'a
                             'type 'symbol}}
                     (AST.ann '(fn [a] a))
                     "annotates fn"
                     Dynamic.Map.=)

  (assert-dynamic-op test
                     {'value '(break)
                      'type 'break}
                     (AST.ann '(break))
                     "annotates break"
                     Dynamic.Map.=)

  (assert-dynamic-op test
                     {'value '(set! x 1)
                      'type 'set!
                      'target {'value 'x
                               'type 'symbol}
                      'bound-to {'value 1
                                 'type 'number
                                 'width 'int}}
                     (AST.ann '(set! x 1))
                     "annotates set!"
                     Dynamic.Map.=)

  (assert-dynamic-op test
                     {'value '(the (Ref Int) x)
                      'type 'the
                      'target-type '(Ref Int)
                      'body {'value 'x
                             'type 'symbol}}
                     (AST.ann '(the (Ref Int) x))
                     "annotates the with compound type"
                     Dynamic.Map.=)

  (assert-dynamic-op test
                     {'value '(ref x)
                      'type 'ref
                      'body {'value 'x
                             'type 'symbol}}
                     (AST.ann '(ref x))
                     "annotates ref"
                     Dynamic.Map.=)

  (assert-dynamic-op test
                     {'value '(deref x)
                      'type 'deref
                      'body {'value 'x
                             'type 'symbol}}
                     (AST.ann '(deref x))
                     "annotates deref"
                     Dynamic.Map.=)

  (assert-dynamic-op test
                     {'value '(with Foo x)
                      'type 'with
                      'module 'Foo
                      'body (list {'value 'x
                                   'type 'symbol})}
                     (AST.ann '(with Foo x))
                     "annotates with"
                     Dynamic.Map.=)

  (assert-dynamic-op test
                     {'value '(match x _ 1)
                      'type 'match
                      'scrutinee {'value 'x
                                  'type 'symbol}
                      'cases (list
                        {'pattern '_
                         'body {'value 1
                                'type 'number
                                'width 'int}})}
                     (AST.ann '(match x _ 1))
                     "annotates match with wildcard"
                     Dynamic.Map.=)

  (assert-dynamic-op test
                     {'value '(match x 0 "zero" 1 "one")
                      'type 'match
                      'scrutinee {'value 'x
                                  'type 'symbol}
                      'cases (list
                        {'pattern 0
                         'body {'value "zero"
                                'type 'string}}
                        {'pattern 1
                         'body {'value "one"
                                'type 'string}})}
                     (AST.ann '(match x 0 "zero" 1 "one"))
                     "annotates match with multiple cases"
                     Dynamic.Map.=)

  (assert-dynamic-op test
                     {'value '(match-ref x _ 1)
                      'type 'match-ref
                      'scrutinee {'value 'x
                                  'type 'symbol}
                      'cases (list
                        {'pattern '_
                         'body {'value 1
                                'type 'number
                                'width 'int}})}
                     (AST.ann '(match-ref x _ 1))
                     "annotates match-ref"
                     Dynamic.Map.=)

  ; property: (unann (ann x)) = x for every supported form
  (assert-dynamic-op test 'foo (AST.unann (AST.ann 'foo)) "roundtrip symbol" =)
  (assert-dynamic-op test 1 (AST.unann (AST.ann '1)) "roundtrip int" =)
  (assert-dynamic-op test 1.5f (AST.unann (AST.ann '1.5f)) "roundtrip float" =)
  (assert-dynamic-op test 1.5 (AST.unann (AST.ann '1.5)) "roundtrip double" =)
  (assert-dynamic-op test "hi" (AST.unann (AST.ann '"hi")) "roundtrip string" =)
  (assert-dynamic-op test true (AST.unann (AST.ann 'true)) "roundtrip boolean" =)
  (assert-dynamic-op test \a (AST.unann (AST.ann '\a)) "roundtrip character" =)
  (assert-dynamic-op test '() (AST.unann (AST.ann '())) "roundtrip unit" =)
  (assert-dynamic-op test
                     '[1 2 3]
                     (AST.unann (AST.ann '[1 2 3]))
                     "roundtrip array"
                     =)
  (assert-dynamic-op test
                     '(a 1 2)
                     (AST.unann (AST.ann '(a 1 2)))
                     "roundtrip application"
                     =)
  (assert-dynamic-op test
                     '(def a 1)
                     (AST.unann (AST.ann '(def a 1)))
                     "roundtrip def"
                     =)
  (assert-dynamic-op test
                     '(defdynamic a 1)
                     (AST.unann (AST.ann '(defdynamic a 1)))
                     "roundtrip defdynamic"
                     =)
  (assert-dynamic-op test
                     '(defn f [a] a)
                     (AST.unann (AST.ann '(defn f [a] a)))
                     "roundtrip defn"
                     =)
  (assert-dynamic-op test
                     '(defndynamic f [a] a)
                     (AST.unann (AST.ann '(defndynamic f [a] a)))
                     "roundtrip defndynamic"
                     =)
  (assert-dynamic-op test
                     '(do 1 2 3)
                     (AST.unann (AST.ann '(do 1 2 3)))
                     "roundtrip do"
                     =)
  (assert-dynamic-op test
                     '(while true 1)
                     (AST.unann (AST.ann '(while true 1)))
                     "roundtrip while"
                     =)
  (assert-dynamic-op test
                     '(if true 1 2)
                     (AST.unann (AST.ann '(if true 1 2)))
                     "roundtrip if"
                     =)
  (assert-dynamic-op test
                     '(quote foo)
                     (AST.unann (AST.ann '(quote foo)))
                     "roundtrip quote"
                     =)
  (assert-dynamic-op test
                     '(deftype Foo [x Int])
                     (AST.unann (AST.ann '(deftype Foo [x Int])))
                     "roundtrip deftype"
                     =)
  (assert-dynamic-op test
                     '(register foo (Fn [] Int))
                     (AST.unann (AST.ann '(register foo (Fn [] Int))))
                     "roundtrip register without override"
                     =)
  (assert-dynamic-op test
                     '(register foo (Fn [] Int) "foo_c")
                     (AST.unann (AST.ann '(register foo (Fn [] Int) "foo_c")))
                     "roundtrip register with override"
                     =)
  (assert-dynamic-op test
                     '(register-type Foo)
                     (AST.unann (AST.ann '(register-type Foo)))
                     "roundtrip bare register-type"
                     =)
  (assert-dynamic-op test
                     '(register-type Foo [x Int])
                     (AST.unann (AST.ann '(register-type Foo [x Int])))
                     "roundtrip register-type with members"
                     =)
  (assert-dynamic-op test
                     '(register-type Foo "Foo_c")
                     (AST.unann (AST.ann '(register-type Foo "Foo_c")))
                     "roundtrip register-type with only override"
                     =)
  (assert-dynamic-op test
                     '(register-type Foo "Foo_c" [x Int])
                     (AST.unann (AST.ann '(register-type Foo "Foo_c" [x Int])))
                     "roundtrip register-type with override and members"
                     =)
  (assert-dynamic-op test
                     '(defmodule Foo (def x 1))
                     (AST.unann (AST.ann '(defmodule Foo (def x 1))))
                     "roundtrip defmodule"
                     =)
  (assert-dynamic-op test
                     '(let [a 1
                            b 2] a)
                     (AST.unann (AST.ann '(let [a 1
                                                b 2] a)))
                     "roundtrip let"
                     =)
  (assert-dynamic-op test
                     '(fn [a] a)
                     (AST.unann (AST.ann '(fn [a] a)))
                     "roundtrip fn"
                     =)
  (assert-dynamic-op test
                     '(break)
                     (AST.unann (AST.ann '(break)))
                     "roundtrip break"
                     =)
  (assert-dynamic-op test
                     '(set! x 1)
                     (AST.unann (AST.ann '(set! x 1)))
                     "roundtrip set!"
                     =)
  (assert-dynamic-op test
                     '(the (Ref Int) x)
                     (AST.unann (AST.ann '(the (Ref Int) x)))
                     "roundtrip the"
                     =)
  (assert-dynamic-op test
                     '(ref x)
                     (AST.unann (AST.ann '(ref x)))
                     "roundtrip ref"
                     =)
  (assert-dynamic-op test
                     '(deref x)
                     (AST.unann (AST.ann '(deref x)))
                     "roundtrip deref"
                     =)
  (assert-dynamic-op test
                     '(with Foo x)
                     (AST.unann (AST.ann '(with Foo x)))
                     "roundtrip with"
                     =)
  (assert-dynamic-op test
                     '(match x 0 "zero" 1 "one")
                     (AST.unann (AST.ann '(match x 0 "zero" 1 "one")))
                     "roundtrip match"
                     =)
  (assert-dynamic-op test
                     '(match-ref x _ 1)
                     (AST.unann (AST.ann '(match-ref x _ 1)))
                     "roundtrip match-ref"
                     =)

  ; new builtins: cond
  (assert-dynamic-op test
                     {'value '(cond true 1 false 2 3)
                      'type 'cond
                      'cases (list
                        {'condition {'value true
                                     'type 'boolean}
                         'body {'value 1
                                'type 'number
                                'width 'int}}
                        {'condition {'value false
                                     'type 'boolean}
                         'body {'value 2
                                'type 'number
                                'width 'int}})
                      'else {'value 3
                             'type 'number
                             'width 'int}}
                     (AST.ann '(cond true 1 false 2 3))
                     "annotates cond"
                     Dynamic.Map.=)

  ; new builtins: case
  (assert-dynamic-op test
                     {'value '(case x 0 "zero" "default")
                      'type 'case
                      'scrutinee {'value 'x
                                  'type 'symbol}
                      'cases (list
                        {'pattern 0
                         'body {'value "zero"
                                'type 'string}})
                      'else {'value "default"
                             'type 'string}}
                     (AST.ann '(case x 0 "zero" "default"))
                     "annotates case"
                     Dynamic.Map.=)

  ; new builtins: for
  (assert-dynamic-op test
                     {'value '(for [i 0 10] i)
                      'type 'for
                      'variable 'i
                      'from {'value 0
                             'type 'number
                             'width 'int}
                      'to {'value 10
                           'type 'number
                           'width 'int}
                      'body {'value 'i
                             'type 'symbol}}
                     (AST.ann '(for [i 0 10] i))
                     "annotates for"
                     Dynamic.Map.=)

  ; new builtins: address
  (assert-dynamic-op test
                     {'value '(address x)
                      'type 'address
                      'body {'value 'x
                             'type 'symbol}}
                     (AST.ann '(address x))
                     "annotates address"
                     Dynamic.Map.=)

  ; new builtins: defmacro
  (assert-dynamic-op test
                     {'value '(defmacro foo [x] x)
                      'type 'defmacro
                      'name 'foo
                      'arguments '[x]
                      'body {'value 'x
                             'type 'symbol}}
                     (AST.ann '(defmacro foo [x] x))
                     "annotates defmacro"
                     Dynamic.Map.=)

  ; new builtins: definterface
  (assert-dynamic-op test
                     {'value '(definterface zero (Fn [] a))
                      'type 'definterface
                      'name 'zero
                      'signature '(Fn [] a)}
                     (AST.ann '(definterface zero (Fn [] a)))
                     "annotates definterface"
                     Dynamic.Map.=)

  ; new builtins: use
  (assert-dynamic-op test
                     {'value '(use Array)
                      'type 'use
                      'module 'Array}
                     (AST.ann '(use Array))
                     "annotates use"
                     Dynamic.Map.=)

  ; new builtins: load
  (assert-dynamic-op test
                     {'value '(load "core.carp")
                      'type 'load
                      'path "core.carp"}
                     (AST.ann '(load "core.carp"))
                     "annotates load"
                     Dynamic.Map.=)

  ; new builtins: doc
  (assert-dynamic-op test
                     {'value '(doc foo "does a thing")
                      'type 'doc
                      'name 'foo
                      'docstring "does a thing"}
                     (AST.ann '(doc foo "does a thing"))
                     "annotates doc"
                     Dynamic.Map.=)

  ; new builtins: hidden
  (assert-dynamic-op test
                     {'value '(hidden foo)
                      'type 'hidden
                      'name 'foo}
                     (AST.ann '(hidden foo))
                     "annotates hidden"
                     Dynamic.Map.=)

  ; new builtins: private
  (assert-dynamic-op test
                     {'value '(private foo)
                      'type 'private
                      'name 'foo}
                     (AST.ann '(private foo))
                     "annotates private"
                     Dynamic.Map.=)

  ; new builtins: implements
  (assert-dynamic-op test
                     {'value '(implements zero Int.zero)
                      'type 'implements
                      'interface 'zero
                      'function 'Int.zero}
                     (AST.ann '(implements zero Int.zero))
                     "annotates implements"
                     Dynamic.Map.=)

  ; roundtrips for new builtins
  (assert-dynamic-op test
                     '(cond true 1 false 2 3)
                     (AST.unann (AST.ann '(cond true 1 false 2 3)))
                     "roundtrip cond"
                     =)
  (assert-dynamic-op test
                     '(case x 0 "zero" "default")
                     (AST.unann (AST.ann '(case x 0 "zero" "default")))
                     "roundtrip case"
                     =)
  (assert-dynamic-op test
                     '(for [i 0 10] i)
                     (AST.unann (AST.ann '(for [i 0 10] i)))
                     "roundtrip for"
                     =)
  (assert-dynamic-op test
                     '(address x)
                     (AST.unann (AST.ann '(address x)))
                     "roundtrip address"
                     =)
  (assert-dynamic-op test
                     '(defmacro foo [x] x)
                     (AST.unann (AST.ann '(defmacro foo [x] x)))
                     "roundtrip defmacro"
                     =)
  (assert-dynamic-op test
                     '(definterface zero (Fn [] a))
                     (AST.unann (AST.ann '(definterface zero (Fn [] a))))
                     "roundtrip definterface"
                     =)
  (assert-dynamic-op test
                     '(use Array)
                     (AST.unann (AST.ann '(use Array)))
                     "roundtrip use"
                     =)
  (assert-dynamic-op test
                     '(load "core.carp")
                     (AST.unann (AST.ann '(load "core.carp")))
                     "roundtrip load"
                     =)
  (assert-dynamic-op test
                     '(doc foo "does a thing")
                     (AST.unann (AST.ann '(doc foo "does a thing")))
                     "roundtrip doc"
                     =)
  (assert-dynamic-op test
                     '(hidden foo)
                     (AST.unann (AST.ann '(hidden foo)))
                     "roundtrip hidden"
                     =)
  (assert-dynamic-op test
                     '(private foo)
                     (AST.unann (AST.ann '(private foo)))
                     "roundtrip private"
                     =)
  (assert-dynamic-op test
                     '(implements zero Int.zero)
                     (AST.unann (AST.ann '(implements zero Int.zero)))
                     "roundtrip implements"
                     =)

  (assert-dynamic-op test
                     '(defn f [a b] (let [c (+ a b)] (if (> c 0) c 0)))
                     (AST.unann
                       (AST.ann
                         '(defn f [a b] (let [c (+ a b)] (if (> c 0) c 0)))))
                     "roundtrip deeply nested form"
                     =)

  (assert-dynamic-op test
                     '(if true 99 1)
                     (AST.unann
                       (let [a (AST.ann '(if true 1 99))]
                         (Map.put (Map.put a 'then (Map.get a 'else))
                                  'else
                                  (Map.get a 'then))))
                     "rewrite if by swapping then/else via the annotation"
                     =))
